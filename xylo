-- Auto-scale UI on mobile viewport changes
local function updateScaleForViewport()
    if not isMobile then return end
    local vp = currentCamera.ViewportSize
    if vp.X < 800 or vp.Y < 600 then
        local fitScale = math.min((vp.X * 0.85) / HW, (vp.Y * 0.85) / 500)
        uiScaleInst.Scale = math.clamp(fitScale, 0.5, tbl3.UIScale)
    else
        uiScaleInst.Scale = tbl3.UIScale
    end
end
currentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScaleForViewport)
task.defer(function() task.wait(0.1); syncHeight(); updateScaleForViewport() end)

