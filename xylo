local function makeSlider(parent,image,text,minV,maxV,initV,step,cb)
    local row=Instance.new("Frame",parent)
    row.Size=UDim2.new(1,0,0,50); row.BackgroundColor3=tbl5.bgRow
    row.BorderSizePixel=0; row.ZIndex=6
    Instance.new("UICorner",row).CornerRadius=UDim.new(0,8)
    local us=Instance.new("UIStroke",row); us.Color=tbl5.border; us.Thickness=1; us.Transparency=0.4
    local ic=Instance.new("ImageLabel",row)
    ic.Image=image; ic.ImageColor3=tbl5.accentDim; ic.BackgroundTransparency=1
    ic.Size=UDim2.new(0,15,0,15); ic.Position=UDim2.new(0,12,0,10); ic.ZIndex=7
    local lb=Instance.new("TextLabel",row)
    lb.Size=UDim2.new(1,-90,0,15); lb.Position=UDim2.new(0,36,0,6)
    lb.BackgroundTransparency=1; lb.Text=text; lb.TextColor3=tbl5.text; lb.TextSize=12
    lb.Font=Enum.Font.GothamMedium; lb.TextXAlignment=Enum.TextXAlignment.Left; lb.ZIndex=7
    local vl=Instance.new("TextLabel",row)
    vl.Size=UDim2.new(0,52,0,15); vl.Position=UDim2.new(1,-60,0,6)
    vl.BackgroundTransparency=1
    vl.Text=string.format(step<1 and "%.2f" or "%d",initV)
    vl.TextColor3=tbl5.accentHi; vl.TextSize=12; vl.Font=Enum.Font.GothamBold
    vl.TextXAlignment=Enum.TextXAlignment.Right; vl.ZIndex=7
    local track=Instance.new("Frame",row)
    track.Size=UDim2.new(1,-24,0,4); track.Position=UDim2.new(0,12,0,34)
    track.BackgroundColor3=tbl5.bgHi; track.BorderSizePixel=0; track.ZIndex=7
    Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)
    local fill=Instance.new("Frame",track)
    fill.Size=UDim2.new((initV-minV)/(maxV-minV),0,1,0)
    fill.BackgroundColor3=tbl5.accent; fill.BorderSizePixel=0; fill.ZIndex=8
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
    local thumb=Instance.new("Frame",track)
    thumb.Size=UDim2.new(0,12,0,12); thumb.Position=UDim2.new((initV-minV)/(maxV-minV),-6,0.5,-6)
    thumb.BackgroundColor3=tbl5.white; thumb.BorderSizePixel=0; thumb.ZIndex=9
    Instance.new("UICorner",thumb).CornerRadius=UDim.new(1,0)
    local dragging=false
    local function upd(x)
        local px=track.AbsolutePosition.X; local sx=track.AbsoluteSize.X; if sx<=0 then return end
        local raw=minV+math.clamp((x-px)/sx,0,1)*(maxV-minV)
        local sn=math.clamp(math.floor(raw/step+0.5)*step,minV,maxV)
        local t=(sn-minV)/(maxV-minV)
        fill.Size=UDim2.new(t,0,1,0); thumb.Position=UDim2.new(t,-6,0.5,-6)
        vl.Text=string.format(step<1 and "%.2f" or "%d",sn); cb(sn)
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            dragging=true; upd(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then upd(i.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=false end
    end)
    return row
end

